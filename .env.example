APP_ENV=development

# Local Python run outside Docker can use localhost.
# Docker Compose overrides DATABASE_URL to use host "db" automatically.
DATABASE_URL=postgresql://postgres:password@localhost:5432/plagiarism_db

# Docker Compose PostgreSQL / pgvector settings.
POSTGRES_DB=plagiarism_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432
POSTGRES_BIND_HOST=127.0.0.1

# Host Cloudflared forwards to the loopback API; neither port needs a public bind.
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PORT=8000

# Optional: permit frontend developers on this VM's private Tailscale address.
# Keep blank for a loopback-only API. To enable on Linux, set this to the VM's
# exact Tailscale IPv4 and uncomment COMPOSE_FILE (from the backend directory).
BACKEND_TAILNET_IP=
# COMPOSE_FILE=docker-compose.yml:docker-compose.tailnet.yml

# Container limits. Tune against VM capacity and measured thesis workloads.
BACKEND_MEMORY_LIMIT=768m
BACKEND_CPU_LIMIT=1.0
BACKEND_PIDS_LIMIT=128
BACKEND_TMPFS_SIZE=128m
CHECK_WORKER_MEMORY_LIMIT=1536m
CHECK_WORKER_CPU_LIMIT=1.5
CHECK_WORKER_PIDS_LIMIT=256
CHECK_WORKER_TMPFS_SIZE=256m

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Total request bytes, including multipart overhead; counted before form parsing.
MAX_REQUEST_BODY_BYTES=11534336
MAX_CONCURRENT_BODY_REQUESTS=4
REQUEST_BODY_TIMEOUT_SECONDS=60

# Bounded PDF extraction and killable validation/worker deadlines.
MAX_PDF_PAGES=500
MAX_EXTRACTED_TEXT_CHARS=2000000
MAX_DOCUMENT_CHUNKS=10000
PDF_VALIDATION_TIMEOUT_SECONDS=120
PDF_VALIDATION_MAX_CONCURRENT=2
CHECK_JOB_TIMEOUT_SECONDS=1200

# Reset requires APP_ENV=development AND this explicit opt-in; keep disabled.
ENABLE_DESTRUCTIVE_RESET=false

# Batas antrean pemeriksaan agar PDF/NLP tidak membebani VM secara bersamaan.
CHECK_DAILY_LIMIT=3
CHECK_QUOTA_TIMEZONE=Asia/Makassar
CHECK_MAX_ACTIVE_PER_STUDENT=1
CHECK_MAX_QUEUED=25
CHECK_MAX_CANDIDATES=20
CHECK_MAX_AUTO_INDEX_REPOSITORY=50
CHECK_AUTO_INDEX_EMBEDDINGS=true
CHECK_POLL_AFTER_MS=5000
CHECK_WORKER_POLL_SECONDS=2
CHECK_STALE_SECONDS=2700
CHECK_MAX_ATTEMPTS=2

# JWT / local auth. Generate a unique value of at least 32 random characters;
# the backend refuses placeholder or short secrets at startup.
JWT_SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=60

# Only creates admin "cihuy" if it does not exist. Leave empty after bootstrap.
# When supplied, use a unique password of at least 12 characters.
BOOTSTRAP_ADMIN_PASSWORD=

# Persisted backend login throttling; no Cloudflare setup is required.
LOGIN_ACCOUNT_MAX_FAILURES=5
LOGIN_IP_MAX_ATTEMPTS=30
LOGIN_WINDOW_SECONDS=900
# Comma-separated immediate proxy CIDRs. Empty trusts no forwarded IP headers.
# Set only after verifying the socket peer of the host Cloudflared connection.
LOGIN_TRUSTED_PROXY_CIDRS=

# Session cookie. Production defaults to Secure=true; use `none` only with
# HTTPS and SESSION_COOKIE_SECURE=true (for cross-site frontend/API setups).
SESSION_COOKIE_NAME=plagiarism_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_PATH=/

# External embedding service. Backend calls this API; it does not run Torch locally.
EMBED_URL=https://your-embedding-server.example/v1
EMBED_API_KEY=your_embedding_api_key
EMBED_MODEL=intfloat/multilingual-e5-small

# CORS (pisahkan domain dengan koma)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
